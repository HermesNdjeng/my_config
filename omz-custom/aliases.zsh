# Shell
alias rz="source ~/.zshrc"
alias reload="source ~/.zshrc"

# Poetry
alias pi="poetry install"
alias pr="poetry run"
alias prc="poetry run pre-commit run"
alias prp="poetry run python"
alias pea='eval $(poetry env activate)'

# uv
alias ui='uv init'
alias ur='uv run'
alias uprc="uv run pre-commit run"
